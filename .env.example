# Optional: Ollama server URL. Default is http://localhost:11434
OLLAMA_HOST=http://localhost:11434
# Model must already be pulled with Ollama, e.g. llama3.2
OLLAMA_MODEL=llama3.2
# Embedding model; first run downloads it from Hugging Face
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Retrieval settings
TOP_K=5
MIN_SIMILARITY=0.25
